 ],
 "constraints": [
  "sq[(v + 1) % 3] == sq[(v + 2) % 3]",
  "sq[v] == 2 * sq[(v + 1) % 3]",
  "ab2 != bc2 or bc2 != ca2"
 ],
 "stem": "Determine the shape of $\\triangle ABC$ with vertices A({=pts[0][0]}, {=pts[0][1]}), B({=pts[1][0]}, {=pts[1][1]}) and C({=pts[2][0]}, {=pts[2][1]}).",
 "solution": [
  "$(AB)^2=({=abx})^2+({=aby})^2={=ab2}$",
  "$(BC)^2=({=bcx})^2+({=bcy})^2={=bc2}$",
  "$(CA)^2=({=cax})^2+({=cay})^2={=ca2}$",
  "$({=l1})^2=({=l2})^2={=leg}$, so the triangle is isosceles.",
  "$({=hyp})^2={=sq[v]}={=leg}+{=leg}=({=l1})^2+({=l2})^2$, so it is right-angled at {=rv}.",
  "$\\triangle ABC$ is an isosceles right-angled triangle with the right angle at {=rv}."
 ],
 "choices": {
  "correct": "Isosceles right-angled triangle (right angle at {=rv})",
