  },
  {
   "name": "tz",
   "let": "\"z\" if r == 1 else \"z^\" + str(r)"
  },
  {
   "name": "d",
   "let": "f[p] * f[q] * f[r]"
  }
 ],
 "constraints": [
  "p + q + r == n"
 ],
 "stem": "Find the coefficient of ${=tx}{=ty}{=tz}$ in the expansion of $(x+y+z)^{{=n}}$.",
 "answer": "f[n] / d",
 "solution": [
  "For ${=tx}{=ty}{=tz}$ in $(x+y+z)^{{=n}}$: n = {=n}, p = {=p}, q = {=q}, r = {=r}, and p + q + r = {=n}.",
  "The coefficient is {=n}!/({=p}!{=q}!{=r}!) = {=f[n]}/{=d} = {=f[n] / d}.",
  "The coefficient is {=f[n] / d}."
 ],
