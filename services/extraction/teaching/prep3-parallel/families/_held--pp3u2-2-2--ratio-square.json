 "constraints": [
  "gcd(p, q) == 1"
 ],
 "stem": "If $\\frac{x}{y}=\\frac{{=p}}{{=q}}$, find the value of $\\frac{{=u}x^2+{=v}y^2}{{=w}xy}$. Give the answer as a fraction in its simplest form (a whole number if it is one).",
 "answer": "{=n}/{=d}",
 "solution": [
  "Since $\\frac{x}{y}=\\frac{{=p}}{{=q}}$, let $x={=p}m$ and $y={=q}m$ with $m\\neq 0$.",
  "$\\frac{{=u}x^2+{=v}y^2}{{=w}xy}=\\frac{{=u}\\times {=p*p}m^2+{=v}\\times {=q*q}m^2}{{=w}\\times {=p*q}m^2}=\\frac{{=n0}m^2}{{=d0}m^2}$.",
  "$=\\frac{{=n0}}{{=d0}}$, which in simplest form is {=n}/{=d}."
 ],
 "marker": {
  "kind": "expression",
  "answer": "{=n}/{=d}",
  "form": "simplest",
  "variables": [],
  "tolerance": null
 },
 "proposed_misconceptions": [],
 "notes": "Advanced twist: squares and a product, so m^2 cancels. Denominator w*p*q is never zero. Modelled on book example 1 with the substitution x=pm, y=qm."
}
