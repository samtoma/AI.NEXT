  {
   "name": "n",
   "let": "k * p + q"
  }
 ],
 "constraints": [
  "gcd(p, q) == 1",
  "p != q"
 ],
 "stem": "If $\\frac{a}{b}=\\frac{{=p}}{{=q}}$, find the value of $\\frac{{=k}a+b}{b}$ as a fraction in its simplest form.",
 "answer": "{=n}/{=q}",
 "solution": [
  "Since $\\frac{a}{b}=\\frac{{=p}}{{=q}}$, let $a={=p}m$ and $b={=q}m$ with $m\\neq 0$.",
  "$\\frac{{=k}a+b}{b}=\\frac{{=k}\\times {=p}m+{=q}m}{{=q}m}$.",
  "$=\\frac{{=n}m}{{=q}m}=\\frac{{=n}}{{=q}}$.",
  "The value of the ratio is $\\frac{{=n}}{{=q}}$."
 ],
 "marker": {
  "kind": "expression",
  "answer": "{=n}/{=q}",
  "form": "simplest",
  "variables": [],
  "tolerance": null
 },
 "proposed_misconceptions": [],
 "notes": "gcd(kp+q,q)=gcd(kp,q)=1 only if gcd(k,q)=1; reduction checked by constraint below."
