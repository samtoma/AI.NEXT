 ],
 "stem": "Which of these points lies on the straight line that represents $f(x)={=a}x {=bs}$, $f:\\mathbb{R}\\to\\mathbb{R}$?",
 "choices": {
  "correct": "$({=k}, {=a*k+b})$",
  "distractors": [
   {
    "text": "$({=k}, {=a*k})$",
    "misconception_id": "mc:pp3u1-4-3:line-always-through-origin"
   },
   {
    "text": "$({=k}, {=a*k-b})$",
    "misconception_id": null
   },
   {
    "text": "$({=k}, {=a*k+a*b})$",
    "misconception_id": null
   }
  ]
 },
 "solution": [
  "Find $f({=k}) = {=a}\\times {=k} {=bs} = {=a*k+b}$.",
  "So the ordered pair $({=k}, {=a*k+b})$ lies on the line.",
  "$({=k}, {=a*k})$ ignores the constant term, as if the line passed through $(0,0)$."
 ],
 "proposed_misconceptions": [],
 "notes": "Distractors are distinct since b != 0 and a >= 2."
}
