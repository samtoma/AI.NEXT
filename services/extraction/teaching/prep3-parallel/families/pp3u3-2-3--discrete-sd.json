 "constraints": [],
 "stem": "The frequency distribution shows the number of defective units ($x$) found in some boxes of manufactured units and the number of boxes ($k$): $x$ = {=m-d}, {=m}, {=m+d} with $k$ = {=a}, {=b}, {=a} boxes respectively. Find the standard deviation of the number of defective units.",
 "answer": "s",
 "solution": [
  "$\\sum k = {=a}+{=b}+{=a} = {=n}$.",
  "$\\sum xk = {=(m-d)*a}+{=m*b}+{=(m+d)*a} = {=m*n}$, so the mean $\\bar{x}={=m*n}\\div {=n}={=m}$.",
  "Deviations $x-\\bar{x}$: {=-d}, 0, {=d}. Squares: {=d*d}, 0, {=d*d}.",
  "Multiply by $k$: {=a*d*d}, 0, {=a*d*d}. So $\\sum (x-\\bar{x})^2k={=q}$.",
  "$\\sigma=\\sqrt{\\dfrac{{=q}}{{=n}}}=\\sqrt{{=s*s}}={=s}$ units."
 ],
 "proposed_misconceptions": [],
 "notes": "Datasets chosen so variance is a perfect square; sigma whole number."
}
