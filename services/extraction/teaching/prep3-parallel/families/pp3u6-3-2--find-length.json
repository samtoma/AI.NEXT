 "source_page": 13,
 "tier": "basic",
 "answer_type": "numeric",
 "context": "A rectangle whose perimeter and area are given; find its dimensions.",
 "params": [
  {
   "name": "W",
   "randint": [
    2,
    8
   ]
  },
  {
   "name": "d",
   "randint": [
    1,
    6
   ]
  },
  {
   "name": "L",
   "let": "W + d"
  },
  {
   "name": "s",
   "let": "L + W"
  },
  {
   "name": "p",
   "let": "2 * s"
  },
  {
   "name": "a",
   "let": "L * W"
  }
 ],
 "constraints": [],
 "stem": "A rectangle has perimeter ${=p}$ cm and area ${=a}$ cm$^2$. Find its length, the longer dimension, in cm.",
 "answer": "L",
 "solution": [
  "Let the length be $x$ and the width be $y$.",
  "Perimeter: $2(x+y) = {=p}$, so $x + y = {=s}$ (first degree).",
  "Area: $xy = {=a}$ (second degree).",
  "From the first equation: $y = {=s} - x$.",
  "Substitute: $x({=s}-x) = {=a}$, so $x^2 - {=s}x + {=a} = 0$.",
  "Factorise: $(x-{=W})(x-{=L}) = 0$, so $x = {=W}$ or $x = {=L}$.",
  "The dimensions are ${=W}$ cm and ${=L}$ cm, so the length (longer) is ${=L}$ cm."
 ],
 "proposed_misconceptions": [],
 "notes": "Integer dimensions, L>W always so the answer is unique."
}
