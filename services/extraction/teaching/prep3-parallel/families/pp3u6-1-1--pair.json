 "stem": "Find the solution of the equation ${=a}x + {=b}y = {=c}$ whose $x$-coordinate is ${=t}$. Write it as an ordered pair $(x, y)$.",
 "marker": {
  "kind": "coordinates",
  "answer": "({=t}, {=s})",
  "form": null,
  "variables": [],
  "tolerance": null
 },
 "solution": [
  "Put $x = {=t}$ in the equation: ${=a} \\times ({=t}) + {=b}y = {=c}$.",
  "So ${=b}y = {=c} - ({=a * t}) = {=b * s}$.",
  "Divide by ${=b}$: $y = {=s}$.",
  "The solution is $({=t}, {=s})$."
 ],
 "notes": "Standard: coefficient of y not 1; y always an integer by construction.",
 "proposed_misconceptions": []
}
