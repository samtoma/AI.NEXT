      "lo": "lo:pp3u9-4-1",
      "label": "Chord length versus distance",
      "statements": [
        {
          "id": "pp3u9-4:rule-1",
          "type": "rule",
          "text": "(MX)^2 + (AX)^2 = (AM)^2 = r^2, a constant expression.",
          "page": 58
        },
        {
          "id": "pp3u9-4:rule-2",
          "type": "rule",
          "text": "The closer the chord is from the center of the circle, the longer its length is and vice versa.",
          "page": 58
        }
      ]
    },
    {
      "lo": "lo:pp3u9-4-2",
      "label": "Equal chords are equidistant",
      "statements": [
        {
          "id": "pp3u9-4:rule-3",
          "type": "rule",
          "text": "Theorem: If chords of a circle are equal in length, then they are equidistant from the center.",
          "page": 59
        },
        {
          "id": "pp3u9-4:rule-4",
          "type": "rule",
          "text": "Corollary: In congruent circles, chords which are equal in length are equidistant from the centers.",
          "page": 59
        }
      ]
    },
    {
      "lo": "lo:pp3u9-4-3",
      "label": "Converse: equidistant chords are equal",
      "statements": [
        {
          "id": "pp3u9-4:rule-5",
          "type": "rule",
          "text": "Converse of the theorem: In the same circle (or in congruent circles) chords which are equidistant from the center(s) are equal in length.",
          "page": 61
        }
      ]
    },
