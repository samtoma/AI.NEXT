  "groups": [
    {
      "lo": "lo:pp3u10-2-1",
      "label": "Inscribed and central angle relation",
      "statements": [
        {
          "id": "pp3u10-2:definition-1",
          "type": "definition",
          "text": "Inscribed angle: an angle whose vertex lies on the circle and whose sides contain two chords of the circle.",
          "page": 71
        },
        {
          "id": "pp3u10-2:rule-1",
          "type": "rule",
          "text": "$\\angle ACB$ is an inscribed angle and $\\overset{\\frown}{AB}$ is the arc opposite to it.",
          "page": 71
        },
        {
          "id": "pp3u10-2:rule-2",
          "type": "rule",
          "text": "For each inscribed angle, there is one central angle subtended by the same arc.",
          "page": 71
        },
        {
          "id": "pp3u10-2:rule-3",
          "type": "rule",
          "text": "Theorem: The measure of the inscribed angle is half the measure of the central angle, subtended by the same arc.",
          "page": 72
        }
      ]
    },
    {
      "lo": "lo:pp3u10-2-2",
      "label": "Inscribed angle and arc measure",
      "statements": [
        {
          "id": "pp3u10-2:rule-4",
          "type": "rule",
          "text": "Corollary (1): The measure of an inscribed angle is half the measure of the subtended arc. Formula: $m(\\angle C)=\\frac{1}{2}m(\\widehat{AB})$",
          "page": 75
        },
        {
          "id": "pp3u10-2:rule-5",
          "type": "rule",
          "text": "Corollary (2): The inscribed angle drawn in a semicircle is a right angle.",
          "page": 75
        }
      ]
    },
    {
