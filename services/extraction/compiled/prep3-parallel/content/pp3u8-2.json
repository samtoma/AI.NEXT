  "groups": [
    {
      "lo": "lo:pp3u8-2-1",
      "label": "Complementary event and its probability",
      "statements": [
        {
          "id": "pp3u8-2:definition-1",
          "type": "definition",
          "text": "If A ⊂ S then A` is the complementary event to event A, where A ∪ A` = S and A ∩ A` = φ. Formula: $A\\cup A'=S, \\ A\\cap A'=\\phi$",
          "page": 35
        },
        {
          "id": "pp3u8-2:rule-1",
          "type": "rule",
          "text": "The event and the complementary event are two mutually exclusive events.",
          "page": 35
        },
        {
          "id": "pp3u8-2:rule-2",
          "type": "rule",
          "text": "P(A) + P(A`) = P(S) = 1 Formula: $P(A)+P(A')=P(S)=1$",
          "page": 36
        }
      ]
    },
    {
      "lo": "lo:pp3u8-2-2",
      "label": "Difference between two events",
      "statements": [
        {
          "id": "pp3u8-2:definition-2",
          "type": "definition",
          "text": "The set A - B (reading Al Akhbar only, not the other newspaper) is read as 'A difference B'.",
          "page": 36
        },
        {
          "id": "pp3u8-2:definition-3",
          "type": "definition",
          "text": "If A, B are events of S, then A-B is the event of the occurrence of A and the non-occurrence of B, i.e. the occurrence of the event A only.",
          "page": 37
        },
        {
          "id": "pp3u8-2:rule-3",
          "type": "rule",
          "text": "Note that (A - B) ∪ (A ∩ B) = A (the symbol between the two brackets is not clearly printed). Formula: $(A - B) \\cup (A \\cap B) = A$",
          "page": 37
        }
      ]
    },
