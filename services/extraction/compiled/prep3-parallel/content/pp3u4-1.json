      "statements": [
        {
          "id": "pp3u4-1:definition-1",
          "type": "definition",
          "text": "A degree equals 60 minutes and a minute equals 60 seconds. Formula: $1^\\circ = 60'$, $1' = 60''$",
          "page": 49
        },
        {
          "id": "pp3u4-1:convention-1",
          "type": "convention",
          "text": "35 degrees, 24 minutes, 42 seconds is written as $35^\\circ 24' 42''$. Formula: $35^\\circ, 24', 42''$",
          "page": 49
        }
      ]
    },
