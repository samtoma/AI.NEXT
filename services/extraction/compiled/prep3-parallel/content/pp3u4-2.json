      "label": "Ratios of 30°, 60°, 45°",
      "statements": [
        {
          "id": "pp3u4-2:rule-1",
          "type": "rule",
          "text": "sin 30° = BD/AB = 1/2 and cos 30° = AD/AB = √3/2 Formula: $\\sin 30^\\circ=\\frac{BD}{AB}=\\frac12$, $\\cos 30^\\circ=\\frac{AD}{AB}=\\frac{\\sqrt3}{2}$",
          "page": 52
        },
        {
          "id": "pp3u4-2:rule-2",
          "type": "rule",
          "text": "tan 30° = BD/AD = 1/√3 Formula: $\\tan 30^\\circ=\\frac{BD}{AD}=\\frac{1}{\\sqrt3}$",
          "page": 52
        },
        {
          "id": "pp3u4-2:rule-3",
          "type": "rule",
          "text": "sin 60° = AD/AB = √3/2 Formula: $\\sin 60^\\circ=\\frac{AD}{AB}=\\frac{\\sqrt3}{2}$",
          "page": 52
        },
        {
          "id": "pp3u4-2:rule-4",
          "type": "rule",
          "text": "cos 60° = BD/AB = 1/2 and tan 60° = AD/BD = √3 Formula: $\\cos 60^\\circ=\\frac{BD}{AB}=\\frac12$, $\\tan 60^\\circ=\\frac{AD}{BD}=\\sqrt3$",
          "page": 52
        },
        {
          "id": "pp3u4-2:rule-5",
          "type": "rule",
          "text": "sin 45° = AC/AB = 1/√2, cos 45° = BC/AB = 1/√2, tan 45° = AC/BC = 1. Formula: $\\sin 45^\\circ=\\frac{AC}{AB}=\\frac{1}{\\sqrt2}, \\ \\cos 45^\\circ=\\frac{BC}{AB}=\\frac{1}{\\sqrt2}, \\ \\tan 45^\\circ=\\frac{AC}{BC}=1$",
          "page": 53
        },
        {
          "id": "pp3u4-2:rule-6",
          "type": "rule",
          "text": "The sine of any angle equals the cosine of the supplementary (complementary) angle of this angle, and vice versa.",
          "page": 53
        }
      ]
    },
    {
      "lo": "lo:pp3u4-2-2",
      "label": "Evaluate special-angle expressions",
      "statements": [
