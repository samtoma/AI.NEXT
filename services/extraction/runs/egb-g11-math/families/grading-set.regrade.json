          "sealed": {
            "correct_answer": "a = 3 \\text{ or } a = 4",
            "canonical_solution": [
              {
                "step": 1,
                "text_md": "Let $P(x)=x^3-5x^2+(a+4)x-a$. $P(1)=1-5+a+4-a=0$, so $(x-1)$ is a factor."
              },
              {
                "step": 2,
                "text_md": "$P(x)=(x-1)(x^2-4x+a)$."
              },
              {
                "step": 3,
                "text_md": "Case 1: $x=1$ is a solution of $x^2-4x+a=0$. $1-4+a=0$, so $a=3$."
              },
              {
                "step": 4,
                "text_md": "Case 2: $x^2-4x+a=0$ has a repeated root. $D=16-4a=0$, so $a=4$."
              },
              {
                "step": 5,
                "text_md": "So $a=3, \\ 4$."
              }
            ],
