            }
          },
          "sealed": {
            "correct_answer": "-3",
            "canonical_solution": [
              {
                "step": 1,
                "text_md": "The three lines fail to form a triangle if the third is parallel to one of the others, or if all three pass through one point."
              },
              {
                "step": 2,
                "text_md": "Gradients: $-1$, $1$, $-m$."
              },
              {
                "step": 3,
                "text_md": "Parallel to the first: $-m=-1$, so $m=1$."
              },
              {
                "step": 4,
                "text_md": "Parallel to the second: $-m=1$, so $m=-1$."
              },
              {
                "step": 5,
                "text_md": "The first two lines meet at $(1, 4)$."
              },
