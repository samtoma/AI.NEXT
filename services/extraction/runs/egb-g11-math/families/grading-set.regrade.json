        {
          "instance_id": "q:eb11c4-2-5:g003-fixed-",
          "blind": {
            "instance_id": "q:eb11c4-2-5:g003-fixed-",
            "stem": "The line $(k+4)x+(k+5)y=-2$ passes through a fixed point for all values of $k$. Find the coordinates of this fixed point.",
            "stem_sha": "5420e4167e04f84d",
            "answer_format": {
              "type": "expression",
              "kind": "coordinates",
              "form": null,
              "variables": []
            }
          },
          "sealed": {
            "correct_answer": "(2, -2)",
            "canonical_solution": [
              {
                "step": 1,
                "text_md": "Move all terms to the left and rearrange in $k$: $(x+y)k+(4x+5y-(-2))=0$."
              },
              {
                "step": 2,
                "text_md": "This holds for every $k$, so $x+y=0$ and $4x+5y=-2$."
              },
              {
                "step": 3,
                "text_md": "From the first, $y=-x$. Substitute: $4x-5x=-2$, so $-1x=-2$."
              },
              {
                "step": 4,
                "text_md": "Hence $x=2$ and $y=-2$."
              },
              {
                "step": 5,
                "text_md": "The fixed point is $(2, -2)$."
              }
            ],
            "marker": {
