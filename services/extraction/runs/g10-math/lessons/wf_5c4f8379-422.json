   "claims": [
    {
     "lo": "lo:g10m8s1-1-1",
     "type": "method",
     "text": "If the coordinates of a figure's vertices are given, the figure can be drawn on the Cartesian plane.",
     "anchor": "b03126",
     "printed_page": 284,
     "supported": true,
     "teacher_only": false,
     "quote": "If we are given the coordinates of the vertices of a figure, we can draw the figure on the Cartesian plane.",
     "provenance": "containment"
    },
    {
     "lo": "lo:g10m8s1-1-2",
     "type": "convention",
     "text": "A point's coordinates are written as the point's label followed by the coordinate pair in parentheses, separated by a semicolon, e.g. A(1;1).",
     "anchor": "b03126",
     "printed_page": 284,
     "supported": true,
     "teacher_only": false,
     "quote": "$A\\left(1;1\\right)$",
     "provenance": "containment"
    },
    {
     "lo": "lo:g10m8s1-1-1",
     "type": "rule",
     "text": "The order of the letters in a figure's name indicates the order in which its vertices must be joined, with the last vertex joined back to the first.",
     "anchor": "b03130",
     "printed_page": 284,
     "supported": true,
     "teacher_only": false,
     "quote": "The order of the letters for naming a figure is important. It indicates the order in which points must be joined: $A$ to $B$ , $B$ to $C$ , $C$ to $D$ and $D$ back to $A$ .",
     "provenance": "containment"
    },
    {
     "lo": "lo:g10m8s1-1-3",
     "type": "convention",
     "text": "It is conventional to name a figure by writing its vertices' letters in alphabetical order (e.g. ABCD, rather than CBAD or BADC).",
     "anchor": "b03130",
     "printed_page": 284,
     "supported": true,
     "teacher_only": false,
     "quote": "it is conventional to write the letters in alphabetical order and so we only refer to the quadrilateral as $ABCD$",
     "provenance": "containment"
    },
    {
     "lo": "lo:g10m8s1-1-2",
     "type": "convention",
     "text": "Coordinates may also be written using a comma instead of a semicolon, e.g. A(1,1).",
     "anchor": "b03128",
     "printed_page": 284,
     "supported": false,
     "teacher_only": false,
     "quote": "$A(1,1)$",
     "provenance": "unsupported"
    }
   ],
