      "source_page": 14,
      "quote": "Guiding Question: How do the fundamental laws of arithmetic allow us",
      "text": "How do the fundamental laws of arithmetic allow us to combine and simplify complex, shifting algebraic fractions to predict outcomes in medicine and life sciences?",
      "provenance": {
        "by": "runbook/book-record.workflow.js ext-v5, sonnet, 2026-10-21",
        "method": "page image"
      }
