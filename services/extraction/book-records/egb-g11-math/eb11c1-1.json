      "type": "rule",
      "lo": "eb11c1-1:objective-2",
      "source_page": 4,
      "quote": "Expansion of (a + b)^n (Binomial Theorem)",
      "claim": "Binomial Theorem: expansion of (a+b)^n as the sum of nCr a^(n-r) b^r for r from 0 to n.",
      "formula": "$(a+b)^n = {}_nC_0 a^n + {}_nC_1 a^{n-1}b + {}_nC_2 a^{n-2}b^2 + \\dots + {}_nC_r a^{n-r}b^r + \\dots + {}_nC_n b^n$",
      "provenance": {
        "by": "runbook/book-record.workflow.js ext-v5, sonnet, 2026-10-21",
        "method": "page image"
      }
    },
    {
