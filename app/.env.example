# --- Which environment this stack is (lib/env.ts, ADR-0007) ---
# `mvp1` is the product on `main`. Every analytics event and cost row is tagged
# with this value, and it decides the skin: on `mvp1` the document carries
# <html data-ds="play">. UNSET falls back to `baseline` — the frozen family-tutor
# stack — which renders with NO data-ds attribute at all (the Ledger identity).
# On `main` that is a misconfiguration, not a look: set this. Production sets
# the same value in deploy/docker-compose.mvp1.yml.
#   mvp1 | baseline
AINEXT_ENVIRONMENT=mvp1

# AI.Next Tutor — TTS (neural voice) configuration
# Copy to `.env.local` (or `.env`) and fill in to enable the neural voice. With
# NO values here, the app defaults to the Web Speech browser voice (the demo
# never breaks). NOTE: never commit a real env file — `.gitignore` ignores
# `.env*`. Keep it that way.

# Which provider to use for /api/tts.
#   openai | elevenlabs | webspeech
# Default: openai if OPENAI_API_KEY set, else elevenlabs if ELEVENLABS_API_KEY
# set, else webspeech.
AINEXT_TTS_PROVIDER=openai

# --- OpenAI TTS (recommended: no voice-tier restriction) ---
# API key. Required for the neural voice. Without it the route returns
# 501 { fallback: "webspeech" } and the client speaks locally.
OPENAI_API_KEY=
# Voice. Default "nova" (warm, friendly). Options incl. alloy, echo, fable,
# onyx, nova, shimmer, coral, sage.
OPENAI_TTS_VOICE=nova
# Model. Default "gpt-4o-mini-tts" (natural, tone-steerable). "tts-1" is faster.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- ElevenLabs (alternative; free tier blocks premade voices via API) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# TEST ONLY — set to 1 to use an in-process mock provider that returns a tiny
# silent mp3 (no key, no network). Leave UNSET in real use.
# AINEXT_TTS_MOCK=1

# --- Console sign-in, LOCAL DEVELOPMENT ONLY (ADR-0022) ---
# !!! NEVER SET THIS ON ANY DEPLOYED STACK !!!
# `on` shows "Sign in as <operator>" on the console's /signin (:3002) and signs
# you in as ANY operator with NO password — the stand-in for Cloudflare Access,
# which proves who you are in production and does not exist on a laptop.
# Three locks, every one checked by the server endpoint, not only the page:
#   1. NODE_ENV is not `production` — and `next build` does not even compile
#      the endpoint (`route.dev.console.ts`), so no deployed image contains it;
#   2. this variable is exactly `on`;
#   3. the request is to localhost / 127.0.0.1 (not the tailnet, not the LAN).
# Every picker sign-in is recorded in auth_events as `dev-picker:<roles>`.
# scripts/local-dev.sh writes it into .env.local for you.
#   on | (unset)
# AINEXT_DEV_OPERATOR_PICKER=on

# --- Console sign-in from Cloudflare Access (ADR-0022) — deployed console only ---
# Unset locally: there is no Cloudflare in front of a laptop. See
# deploy/.env.example for what these do and the values production uses.
# AINEXT_CF_ACCESS_TEAM_DOMAIN=
# AINEXT_CF_ACCESS_AUD=
