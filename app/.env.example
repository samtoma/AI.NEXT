# AI.Next Tutor — TTS (neural voice) configuration
# Copy to `.env.local` (or `.env`) and fill in to enable the neural voice. With
# NO values here, the app defaults to the Web Speech browser voice (the demo
# never breaks). NOTE: never commit a real env file — `.gitignore` ignores
# `.env*`. Keep it that way.

# Which provider to use for /api/tts.
#   openai | elevenlabs | webspeech
# Default: openai if OPENAI_API_KEY set, else elevenlabs if ELEVENLABS_API_KEY
# set, else webspeech.
AINEXT_TTS_PROVIDER=openai

# --- OpenAI TTS (recommended: no voice-tier restriction) ---
# API key. Required for the neural voice. Without it the route returns
# 501 { fallback: "webspeech" } and the client speaks locally.
OPENAI_API_KEY=
# Voice. Default "nova" (warm, friendly). Options incl. alloy, echo, fable,
# onyx, nova, shimmer, coral, sage.
OPENAI_TTS_VOICE=nova
# Model. Default "gpt-4o-mini-tts" (natural, tone-steerable). "tts-1" is faster.
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- ElevenLabs (alternative; free tier blocks premade voices via API) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# TEST ONLY — set to 1 to use an in-process mock provider that returns a tiny
# silent mp3 (no key, no network). Leave UNSET in real use.
# AINEXT_TTS_MOCK=1
