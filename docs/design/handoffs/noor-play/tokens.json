{
  "$meta": {
    "name": "Nour Play Design System",
    "variant": "A",
    "audience": "ages 10-16",
    "layersOn": "Nour master design system v0.2",
    "primaryDevices": [
      "web 1280+",
      "iPad landscape 1024+"
    ],
    "note": "phone is the collapse, not the starting point"
  },
  "color": {
    "bg": {
      "page": "#FFF6E6",
      "surface": "#FFFFFF",
      "warm": "#FFE9BD"
    },
    "ink": {
      "base": "#241F3D",
      "soft": "#6B6489",
      "note": "ink is body text AND every outline"
    },
    "text": {
      "dim": "#4A4266",
      "muted": "#5A5570",
      "label": "#615B7D",
      "eyebrow": "#655B80",
      "link": "#136386",
      "amber": "#A34F0A",
      "amberWarm": "#8A4208",
      "onAmberSmall": "#5E3806"
    },
    "action": {
      "base": "#F0A22F",
      "on": "#241F3D"
    },
    "mastery": {
      "base": "#2F9E8F",
      "on": "#241F3D"
    },
    "celebrate": {
      "base": "#7B4FC9",
      "on": "#FFFFFF",
      "onDim": "#F0E9FB"
    },
    "playmates": {
      "note": "SUBJECT and QUEST coding only — never decoration",
      "sky": {
        "base": "#7FD1F0",
        "on": "#0F3D51",
        "onDim": "#134B63"
      },
      "leaf": {
        "base": "#B6E88F",
        "on": "#1F3D12",
        "onDim": "#3A5B26",
        "also": "correct answers"
      },
      "berry": {
        "base": "#FFA8C5",
        "on": "#7A2447",
        "onDim": "#6E2440",
        "never": "warnings"
      }
    },
    "inactive": {
      "fill": "#F6F5FA",
      "border": "#9C95B8",
      "disabledBorder": "#B4AECB",
      "disabledText": "#8A83A6",
      "disabledTextNote": "permitted only on a [disabled] control"
    },
    "forbidden": "No red anywhere. Correct = leaf green. Wrong = grey fill + nudge animation."
  },
  "sticker": {
    "note": "ABSOLUTE VALUES — never scale with the viewport",
    "stroke": "3px",
    "strokeSmall": "2.5px",
    "strokeSmallThreshold": "under 40px tall",
    "shadow": "4px 4px 0 #241F3D",
    "shadowSm": "3px 3px 0 #241F3D",
    "shadowLg": "6px 6px 0 #241F3D",
    "shadowXl": "7px 7px 0 #241F3D",
    "blur": "none — never any blur",
    "pressOffset": "4px",
    "pressShadow": "0 0 0"
  },
  "radius": {
    "sm": "14px",
    "base": "20px",
    "lg": "28px",
    "pill": "999px"
  },
  "touchTarget": {
    "min": "52px",
    "note": "holds on desktop with a mouse — density is never bought from targets"
  },
  "font": {
    "display": {
      "stack": "\"Baloo Bhaijaan 2\", \"Baloo 2\"",
      "weights": [
        800
      ]
    },
    "ui": {
      "stack": "\"Baloo Bhaijaan 2\", \"Baloo 2\"",
      "weights": [
        700
      ],
      "note": "Baloo runs the WHOLE UI — the deliberate break from master"
    },
    "read": {
      "stack": "\"Cairo\"",
      "weights": [
        400
      ],
      "use": "passages over three lines only"
    },
    "mono": {
      "stack": "\"IBM Plex Mono\"",
      "weights": [
        500
      ],
      "constraint": "LATIN AND WESTERN DIGITS ONLY — no Arabic script, no Arabic-Indic digits"
    }
  },
  "typeScale": [
    {
      "step": "display",
      "size": "2.4rem",
      "face": "Baloo 800",
      "use": "celebrations, screen titles, the big equation"
    },
    {
      "step": "title",
      "size": "1.5rem",
      "face": "Baloo 800",
      "use": "card titles, quest names, student name"
    },
    {
      "step": "ui",
      "size": "1.15rem",
      "face": "Baloo 700",
      "use": "buttons, answer options — the workhorse"
    },
    {
      "step": "label",
      "size": "0.85rem",
      "face": "Baloo 700 / Cairo 700",
      "use": "chips, nav labels, badges, counters"
    },
    {
      "step": "read",
      "size": "1rem",
      "face": "Cairo 400",
      "use": "any passage over three lines"
    },
    {
      "step": "data",
      "size": "0.72rem",
      "face": "IBM Plex Mono 500",
      "use": "step counters, timers, Latin-only labels"
    }
  ],
  "motion": {
    "principle": "reactive, never ambient — every animation answers a student action",
    "hardLimits": [
      "one animation at a time",
      "nothing over 600ms",
      "bob is the only infinite loop"
    ],
    "press": {
      "duration": "90ms",
      "easing": "cubic-bezier(.2,.7,.3,1)",
      "use": "every control on tap"
    },
    "pop": {
      "duration": "380ms",
      "easing": "cubic-bezier(.34,1.6,.64,1)",
      "use": "correct answer, reward, badge landing"
    },
    "nudge": {
      "duration": "420ms",
      "use": "wrong answer — never with a colour change to red"
    },
    "wiggle": {
      "duration": "900ms",
      "loop": true,
      "use": "Nour thinking — only while a response is pending"
    },
    "bob": {
      "duration": "3.2s",
      "loop": true,
      "use": "Nour idle — the only permitted infinite loop"
    },
    "fill": {
      "duration": "1.4s",
      "use": "quest bar advancing, once on arrival"
    },
    "ringSquash": {
      "ring": "1.6s",
      "squash": "1.2s",
      "use": "mastery celebration only"
    }
  },
  "character": {
    "asset": "nour-friend.svg",
    "moods": [
      {
        "name": "idle",
        "motion": "bob 3.2s infinite",
        "when": "waiting for the student"
      },
      {
        "name": "thinking",
        "motion": "wiggle 900ms infinite",
        "when": "response generating — replaces the spinner"
      },
      {
        "name": "encouraging",
        "motion": "pop 380ms once",
        "when": "after a wrong answer, with a hint"
      },
      {
        "name": "celebrating",
        "motion": "squash + ring pulse",
        "when": "a skill reaches mastered"
      }
    ],
    "rule": "NEVER redraw the artwork or add facial expressions. Mood is motion, tilt and ring only.",
    "sizes": {
      "inline": "28px",
      "header": "44px",
      "celebration": "96px",
      "floor": "28px — below that, mark only, no ring"
    }
  },
  "breakpoints": [
    {
      "name": "web",
      "min": 1280,
      "structure": "three pane — 88px rail / workspace / 340px Nour panel",
      "canonical": true,
      "note": "design this first; the companion panel never collapses"
    },
    {
      "name": "ipad-landscape",
      "min": 1024,
      "max": 1194,
      "structure": "two pane — 80px rail / workspace / 300px Nour panel",
      "note": "same component sizes as web; quest map drops out"
    },
    {
      "name": "ipad-portrait",
      "min": 744,
      "max": 1023,
      "structure": "rail + workspace; Nour docks to a bottom sheet"
    },
    {
      "name": "phone",
      "min": 360,
      "max": 430,
      "structure": "single column, bottom nav, inline avatar"
    },
    {
      "name": "split-view",
      "max": 700,
      "structure": "phone layout wholesale — no intermediate layout exists"
    }
  ],
  "caps": {
    "workspace": "820px",
    "textMeasure": "64ch",
    "cardGridColumns": 2,
    "answerOptionColumns": {
      "phone": 1,
      "ipadAndWeb": 2,
      "never": "3+"
    }
  }
}