# Copy to deploy/.env on the box (it is gitignored — NEVER commit real values).
#   cp .env.example .env  &&  edit .env
#
# This file is read by `docker compose -f docker-compose.mvp1.yml` from the
# directory the compose file lives in. Every `${VAR:?...}` in that file must have
# a value here or NO compose command works at all — including `ps` and `config`,
# which is deliberate: a stack you cannot inspect without the secrets present is
# a stack that cannot be half-configured.

# Strong password for the app's Postgres superuser (internal to the compose
# network). This is the OWNER/superuser account. The running app does NOT use
# it — but the `migrate` one-shot service does, because schema changes are an
# owner's act and no other role may create a table in schema `public`
# (see deploy/apply-migrations.sh for the full argument).
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# The three database roles (ADR-0012, migration 017)
# ---------------------------------------------------------------------------
# `ainext_app`      the application. Non-superuser, non-owner, row-level
#                   security applies. THE APP CONNECTS AS THIS.
# `ainext_operator` the admin console. The enumerated cross-student reads by
#                   grant; INSERT-only on the operator-read audit.
# `ainext_maint`    BYPASSRLS. Loader, backfills, rollups, one-off scripts.
#                   Never handed to the running app.
#
# Migration 017 creates all three with NO password, because a migration that
# set one would write a known credential into git. Set them ONCE after the
# first boot, then put the same values here:
#
#   docker compose -p ainext-mvp1 -f deploy/docker-compose.mvp1.yml exec db \
#     psql -U ainext -d ainext_mvp1 \
#       -c "ALTER ROLE ainext_app      PASSWORD '…'" \
#       -c "ALTER ROLE ainext_operator PASSWORD '…'" \
#       -c "ALTER ROLE ainext_maint    PASSWORD '…'"
#
# You are TOLD when this is outstanding: the `migrate` service checks for it on
# every deploy and stops with these exact instructions rather than letting the
# app crash-loop on a password authentication failure.
#
# Check it took, before believing anything is isolated:
#   psql -U ainext -d ainext_mvp1 \
#     -c "SELECT rolname, rolsuper, rolbypassrls FROM pg_roles WHERE rolname LIKE 'ainext_%'"
#   → ainext_app and ainext_operator must both read f | f.
#   (`migrate` asserts this too, on every deploy.)
AINEXT_APP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
AINEXT_OPERATOR_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
AINEXT_MAINT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Identity (ADR-0013)
# ---------------------------------------------------------------------------
# HS256 signing key for the access token. At least 32 bytes:
#   openssl rand -hex 32
# Rotating it signs every student and operator out — which is also how you
# respond to a suspected leak.
#
# NOTE for anyone reusing configuration from the frozen baseline's deploy/.env:
# this variable does not exist there. The baseline predates accounts entirely,
# so AINEXT_AUTH_SECRET and the three role passwords above have to be NEW. Only
# POSTGRES_PASSWORD has a counterpart to reuse.
AINEXT_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Hostnames — see deploy/TAKEOVER.md before changing either of these
# ---------------------------------------------------------------------------
# Absolute origin for the links in verification and reset mail. Never derived
# from the request host: a Host header is client-controlled, and a verification
# link pointed at somebody else's origin verifies for them.
#
# Settled 2026-09-22: the student site is noor.reletix.com. The compose file
# carries that as the default, so this line is only needed for a stack that is
# NOT production (a staging host, a tailnet name, localhost).
AINEXT_PUBLIC_URL=https://noor.reletix.com

# The console's own origin, for the links in OPERATOR mail. Same reason,
# sharper consequence: a reset link built from a client-supplied Host header is
# reset poisoning — the mail arrives from us and the operator's reset token
# walks to the attacker's server.
#
# REQUIRED: compose has no default for it, because the console hostname has not
# been decided. Proposal, awaiting Samuel: noor-console.reletix.com — a sibling
# one label deep, because Universal SSL covers `*.reletix.com` and a wildcard
# matches exactly one label, so `console.noor.reletix.com` would not have a
# certificate.
AINEXT_CONSOLE_URL=https://noor-console.reletix.com

# ---------------------------------------------------------------------------
# Mail (SETUP.md S2)
# ---------------------------------------------------------------------------
# `console` prints links to the container log (fine for a closed pilot, and the
# only honest setting until Mailu actually holds the mailbox);
# `smtp` sends them through the Mailu instance already running on this box.
#
# Switching to `smtp` with AINEXT_SMTP_URL unset does NOT silently fall back —
# it throws, because a student waiting for a verification mail that was never
# sent cannot tell the difference from a slow one.
AINEXT_MAIL_TRANSPORT=console

# nodemailer URL. Implicit TLS on 465 (`smtps://`) or STARTTLS on 587 (`smtp://`).
# THE PASSWORD AND THE @ IN THE USERNAME MUST BE PERCENT-ENCODED — this is a URL,
# and an unencoded `@` in the local part silently reparses the whole thing into a
# different host:
#   smtps://admin%40noor.reletix.com:<url-encoded-password>@mail.reletix.com:465
# Mailu side (dashboard, not code) and the DNS records this needs are in
# deploy/TAKEOVER.md §"Mail".
AINEXT_SMTP_URL=

# The envelope and header From. Must be a mailbox that actually exists in Mailu
# for a domain Mailu is authoritative for, or the message is rejected by the
# receiving side even though the send looked fine.
AINEXT_MAIL_FROM=admin@noor.reletix.com

# ---------------------------------------------------------------------------
# Google sign-in: ALL THREE or none (SETUP.md S1)
# ---------------------------------------------------------------------------
# A partial configuration refuses to start, rather than rendering a button that
# fails at the callback — after the student has already handed Google their
# credentials. Unset leaves the button visibly disabled and labelled
# "not configured".
#
# The redirect URI must be registered in the Google Cloud console against this
# exact origin. It is the single most commonly forgotten thing when a hostname
# changes, and the failure is Google's error page rather than ours, which sends
# people looking in the wrong repository.
AINEXT_GOOGLE_CLIENT_ID=
AINEXT_GOOGLE_CLIENT_SECRET=
AINEXT_GOOGLE_REDIRECT_URI=https://noor.reletix.com/api/auth/google/callback

# The first operator (ADR-0014). Seeded by app/scripts/bootstrap-operator.mts
# with all four roles and NO password; the first one arrives through the
# ordinary reset flow, so no credential ever sits in this file.
AINEXT_BOOTSTRAP_OPERATOR_EMAIL=

# ---------------------------------------------------------------------------
# The course gate (migration 023) — A DECISION, NOT A DEFAULT
# ---------------------------------------------------------------------------
# `off` (and unset) — every student sees every course that is loaded.
# `on`            — a student sees a course only where a `course_availability`
#                   row says `live` for (environment, course, grade).
#
# Three courses are loaded now and two of them carry questions that have not
# been through the human review gate. `off` therefore puts unreviewed questions
# in front of children, which constitution Principle III still forbids —
# ADR-0007 suspends review for generated EXPLANATIONS only.
#
# The argument against `on` is in app/src/lib/env.ts and it is a good one: an
# empty allow-list would lock every student out with no error message anywhere.
# That argument is about a SILENT failure, and it no longer applies here — the
# `migrate` service refuses to finish when the gate is on and no course is
# allow-listed, and prints the INSERT to run.
#
# RECOMMENDED: on, with `course:prep3-math-en` allow-listed. Samuel decides.
AINEXT_COURSE_GATING=off

# ---------------------------------------------------------------------------
# Monitoring and analytics (ADR-0016)
# ---------------------------------------------------------------------------
# GA4 measurement id, `G-XXXXXXXXXX`, student surface only — it is never loaded
# on the console. Unset renders no script tag at all, which is a supported
# state. A malformed value refuses to start rather than reporting into nothing.
AINEXT_GA_MEASUREMENT_ID=

# Where app/scripts/alerts-sweep.mts mails an alert. Unset means the sweep still
# runs, still evaluates every rule and still records that one fired — it logs
# the body instead of mailing it.
AINEXT_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# RELEASE_TAG — normally set by the deploy job, not by hand
# ---------------------------------------------------------------------------
# The deploy job computes it from the deployed commit (the git tag when the
# commit carries one, otherwise version+short sha) and exports it into compose's
# environment, which wins over this file. Set it here only when bringing the
# stack up by hand and you want the turns stamped with something meaningful.
#
# ⚠ It is INERT until a one-line change lands in app/src/lib/env.ts — see the
# comment on this variable in docker-compose.mvp1.yml.
RELEASE_TAG=

# NOTE: no ANTHROPIC_API_KEY. The bundled `claude` CLI runs on Samuel's Claude
# subscription — you log in once, INTERACTIVELY, inside the container, and the
# login persists in the claude_cfg Docker volume across redeploys. It has
# lapsed; deploy/TAKEOVER.md §"Reactivating the Claude CLI" is the procedure.
