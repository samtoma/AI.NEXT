# Copy to deploy/.env on the box (it is gitignored — NEVER commit real values).
#   cp .env.example .env  &&  edit .env

# Strong password for the app's Postgres (internal to the compose network).
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# NOTE: no ANTHROPIC_API_KEY. The bundled `claude` CLI runs on your Claude
# subscription — you log in once (see DEPLOY.md) and the login persists in the
# claude_cfg Docker volume across redeploys.
