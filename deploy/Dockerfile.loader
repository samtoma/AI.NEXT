# AI.Next content loader — the seed loader (services/extraction/load_seed.py) in a
# throwaway container that can reach the stack's Postgres.
#
# DEPENDENCIES ONLY. The loader code and the seed bundles arrive as a READ-ONLY
# bind mount of the repo checkout, so refreshing content never rebuilds this
# image, and the image can never hold a stale copy of a bundle.
#
# Versions pinned to services/extraction/uv.lock so the box loads exactly what
# was tested locally. Both wheels publish linux/arm64 manylinux builds, so this
# needs no compiler on the (ARM) box. If a future pin ever lacks an arm64 wheel,
# pip will try to compile and fail HERE — at build time, before anything touches
# the database. The fix is then `apt-get install -y libpq5` + `psycopg[c]`, or
# add build-essential; it is never to skip the loader.
#
# NODE AND KATEX (v0.12.2). Before it loads a bundle, load_seed.py renders every
# student-facing maths string with the APP'S OWN KaTeX (services/extraction/
# katex_check.mjs, consistency review A1/A2), which runs on node and imports
# app/src/lib/math-text.ts (TypeScript: node >= 22.18 strips the types). Without
# them the check cannot run and the load refuses — which is what stopped the first
# Grade 10 dry run on the box (2026-10-12). katex is installed at /node_modules, so
# node finds it from /repo/app when it climbs the directories; its version is the
# app's locked one (app/package-lock.json: katex 0.17.0, commander 8.3.0) — bump
# both together when the app moves.
# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS node
RUN npm install --prefix /k --no-save --no-audit --no-fund katex@0.17.0 commander@8.3.0

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir \
      "pydantic==2.13.4" \
      "psycopg[binary]==3.3.4"

# node's own runtime libraries; then node itself, and the app's KaTeX
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /k/node_modules /node_modules
RUN node --version && node -e "require('/node_modules/katex').renderToString('x^2')"

# The mount is read-only and nothing here writes to disk; run unprivileged.
USER nobody
WORKDIR /repo/services/extraction
ENTRYPOINT ["python", "load_seed.py"]
