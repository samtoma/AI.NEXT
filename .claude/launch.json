        "127.0.0.1"
      ],
      "cwd": "app",
      "port": 3011,
      "env": {
        "DATABASE_URL": "postgres://ainext_app:ainext_app@127.0.0.1:5432/ainext_pilot_g10_ch08",
        "DATABASE_URL_OPERATOR": "postgres://ainext_operator:ainext_operator@127.0.0.1:5432/ainext_pilot_g10_ch08",
        "DATABASE_URL_MAINT": "postgres://ainext_maint:ainext_maint@127.0.0.1:5432/ainext_pilot_g10_ch08",
